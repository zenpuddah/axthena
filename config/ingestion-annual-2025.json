{
  "schema_version": "axthena.ingestion.v1",
  "store": "../artifacts/neo4j-v1/store",
  "schedule": {"every_seconds": 21600},
  "collection": {
    "mode": "backfill", "from": "2025-01-01", "to": "2025-12-31",
    "partition": "month", "page_size": 10, "articles_per_scope": 2,
    "pages_per_scope": 4, "max_requests": 96
  },
  "fetch": {
    "concurrency": 2, "timeout_seconds": 30, "interval_seconds": 1,
    "max_attempts": 3, "retry_base_seconds": 2, "retry_max_seconds": 120,
    "conditional_requests": true, "revalidate_after_seconds": 21600
  },
  "sources": [
    {"id": "nvidia-blog", "ingestor": "wordpress", "name": "NVIDIA Blog", "endpoint": "https://blogs.nvidia.com/wp-json/wp/v2/posts"},
    {"id": "microsoft-cloud", "ingestor": "wordpress", "name": "Microsoft Cloud Blog", "endpoint": "https://www.microsoft.com/en-us/microsoft-cloud/blog/wp-json/wp/v2/posts"}
  ],
  "processing": {"prepare": true, "config": "ingestion-processing-v1.json", "attempt": "initial"}
}
